# Public address of the site, no trailing slash. Used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL="https://toursside.com"

# WhatsApp number that receives demo and subscription requests when email is not set up, digits only with country code.
NEXT_PUBLIC_WHATSAPP_NUMBER="97451131080"

# Email delivery for the demo and subscription forms (https://resend.com). Until these are set, the forms hand the
# visitor a ready-written WhatsApp message instead, so no request is lost.
RESEND_API_KEY=""
REQUESTS_FROM="Toursside <hello@your-domain.com>"   # must be on a domain verified in Resend
REQUESTS_TO="you@your-domain.com"                    # where requests land; several addresses separated by commas
